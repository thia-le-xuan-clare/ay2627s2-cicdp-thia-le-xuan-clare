<Window x:Class="Waddle.Wpf.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Waddle.Wpf"
        Title="Waddle widget" Width="300" Height="370" MinWidth="180" MinHeight="120"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource Surface}"
        BorderThickness="0"
        FontFamily="Segoe UI Variable, Segoe UI"
        Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="CameraRow" Height="*"/>
            <RowDefinition x:Name="TimerRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move -->
        <DockPanel Grid.Row="0" Background="{StaticResource Bg}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ToolTip="Close widget (timer keeps running)"
                    Style="{StaticResource WaddleButton}" Background="Transparent" BorderThickness="0" Padding="10,6" Click="Close_Click"/>
            <Button x:Name="SizeButton" DockPanel.Dock="Right" Content="&#xE73F;" FontFamily="Segoe MDL2 Assets" ToolTip="Make smaller"
                    Style="{StaticResource WaddleButton}" Background="Transparent" BorderThickness="0" Padding="10,6" Click="Size_Click"/>
            <TextBlock Text="Waddle" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- Camera (shown from the shared CameraMonitor; mirrored like a webcam) -->
        <Grid Grid.Row="1" Background="#2A2412" ClipToBounds="True">
            <Image Source="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=Frame}"
                   Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform>
            </Image>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"
                        Visibility="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=HasOverlay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=OverlayText}"
                           Foreground="#CDBB85" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Try again" Margin="0,10,0,0" Padding="14,6" HorizontalAlignment="Center"
                        Style="{StaticResource WaddleButton}" Click="Retry_Click"
                        Visibility="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=HasProblem, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3"
                    CornerRadius="6" Background="#B0000000"
                    Visibility="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=HasFrame, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Source={x:Static local:CameraMonitor.Instance}, Path=FaceText}"
                           Foreground="White" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Timer (scales with the window) -->
        <Viewbox Grid.Row="2" Margin="12,8" Stretch="Uniform">
            <StackPanel x:Name="SessionPanel">
                <TextBlock Text="{Binding Source={x:Static local:TimeTracker.Instance}, Path=SessionText}"
                           FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13">
                    <Run Text="Today "/>
                    <Run Text="{Binding Source={x:Static local:TimeTracker.Instance}, Path=TodayText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"
                           Text="{Binding Source={x:Static local:TimeTracker.Instance}, Path=StatusText}"/>
            </StackPanel>
        </Viewbox>

        <!-- Shown instead of the timer when Recalibrate is clicked -->
        <TextBlock x:Name="CalText" Grid.Row="2" Visibility="Collapsed" Margin="14,10" TextWrapping="Wrap"
                   TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                   Text="Face size calibration is coming next. For now this shows what the camera sees."/>

        <Grid x:Name="Controls" Grid.Row="3" Margin="12,0,12,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Padding="8" Style="{StaticResource WaddleButton}" Click="Pause_Click"
                    Content="{Binding Source={x:Static local:TimeTracker.Instance}, Path=PauseButtonText}"/>
            <Button Grid.Column="2" Content="Stop" Padding="8" Style="{StaticResource PrimaryButton}" Click="Stop_Click"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Waddle.Wpf.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waddle"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Colours match the widget: pastel yellow, dark brown text, orange button. Change them here. -->
        <SolidColorBrush x:Key="BannerBackground" Color="#FFFFF3CD"/>
        <SolidColorBrush x:Key="BannerBorder" Color="#FFF1DFA0"/>
        <SolidColorBrush x:Key="BannerText" Color="#FF3B2F10"/>
        <SolidColorBrush x:Key="BannerMutedText" Color="#FF8C7A55"/>
        <SolidColorBrush x:Key="BannerAccent" Color="#FFE8801F"/>

        <!-- flat rounded button; Focusable=False so clicking it never steals focus from what you're doing -->
        <Style x:Key="BannerButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource BannerText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <!-- while "Trying..." the button is greyed out and can't be pressed again -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Padding="16,9,8,9" CornerRadius="10"
            Background="{StaticResource BannerBackground}"
            BorderBrush="{StaticResource BannerBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- Duck animation (only for banners that ask for one, e.g. the posture warning).
                 Fixed canvas + bottom-aligned frames so swapping frames never makes it jump. -->
            <Viewbox x:Name="DuckPanel" Height="84" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid Width="240" Height="320">
                    <Image Source="{Binding Frame}" Width="{Binding FrameWidth}" Height="{Binding FrameHeight}"
                           Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
            </Viewbox>

            <TextBlock x:Name="MessageText" Foreground="{StaticResource BannerText}" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360"/>

            <Button x:Name="ActionButton" Style="{StaticResource BannerButton}"
                    Margin="14,0,0,0" Padding="14,5" FontWeight="SemiBold"
                    Background="{StaticResource BannerAccent}"
                    Click="Action_Click"/>

            <Button x:Name="CloseButton" Style="{StaticResource BannerButton}"
                    Margin="8,0,0,0" Padding="7,3" Background="Transparent"
                    Foreground="{StaticResource BannerMutedText}"
                    Content="&#x2715;" FontSize="12" VerticalAlignment="Center"
                    ToolTip="Dismiss" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>

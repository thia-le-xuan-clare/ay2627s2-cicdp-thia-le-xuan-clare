<Window x:Class="Waddle.Wpf.StartupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waddle - Start with Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC3B2F14"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown">

    <!-- Full-screen frosted backdrop (sized in code-behind); the card sits in the middle. -->
    <Border Style="{StaticResource Card}" Width="480" Padding="28"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Welcome to Waddle!" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Beak}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Do you want Waddle to start when you log in?" FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="You can change this any time from Settings on the dashboard."
                       Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="NoButton" Content="No thanks" Style="{StaticResource WaddleButton}" MinWidth="130"
                        Margin="0,0,12,0" Click="No_Click"/>
                <Button x:Name="YesButton" Content="Yes, start on login" Style="{StaticResource PrimaryButton}" MinWidth="170"
                        Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
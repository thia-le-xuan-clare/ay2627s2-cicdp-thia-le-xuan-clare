<Window x:Class="Waddle.Wpf.StartupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waddle - Start with Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC3B2F14"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown">

    <!-- Full-screen frosted backdrop (sized in code-behind); the card sits in the middle. -->
    <Border Style="{StaticResource Card}" Width="480" Padding="28"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Welcome to Waddle!" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Beak}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="How should Waddle start?" FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="You can change these any time from Settings on the dashboard."
                       Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>

            <CheckBox x:Name="StartupCheck" Content="Launch Waddle when I sign in to Windows" Margin="0,24,0,0" HorizontalAlignment="Center"
                      Foreground="{StaticResource Ink}" FontSize="14" VerticalContentAlignment="Center"/>
            <TextBlock Text="Automatically opens Waddle when your computer starts."
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>

            <CheckBox x:Name="AutoTimerCheck" Content="Start posture timer automatically on launch" Margin="0,16,0,0" HorizontalAlignment="Center"
                      Foreground="{StaticResource Ink}" FontSize="14" VerticalContentAlignment="Center"/>
            <TextBlock Text="Begins camera tracking immediately whenever Waddle opens."
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>

            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" MinWidth="170"
                    HorizontalAlignment="Center" Margin="0,26,0,0" IsDefault="True" Click="Continue_Click"/>
        </StackPanel>
    </Border>
</Window>
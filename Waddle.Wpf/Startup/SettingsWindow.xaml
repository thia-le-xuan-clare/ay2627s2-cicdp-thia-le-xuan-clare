<Window x:Class="Waddle.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waddle - Settings"
        Icon="pack://application:,,,/Assets/duck-icon/duck_happy.ico"
        Background="{StaticResource Bg}"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource CardTitle}" FontSize="22" FontWeight="ExtraBold"/>

            <CheckBox x:Name="StartupCheck" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"
                      Content="Start Waddle when I log in to Windows"
                      Foreground="{StaticResource Ink}" FontSize="14" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>

            <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Margin="0,22,0,0" IsDefault="True" IsCancel="True" Click="Done_Click"/>
        </StackPanel>
    </Border>
</Window>
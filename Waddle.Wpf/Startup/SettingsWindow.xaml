<Window x:Class="Waddle.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Waddle.Wpf"
        Title="Waddle - Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC3B2F14"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <!-- The window itself is the frosted backdrop (sized to the screen in code-behind); the card sits in the middle. -->
    <local:SettingsPanel x:Name="SettingsCard" Width="440"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         CloseRequested="SettingsCard_CloseRequested"/>
</Window>
<Window x:Class="Waddle.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waddle.Wpf"
        mc:Ignorable="d"
        Title="Waddle" Width="720" Height="420" MinWidth="520" MinHeight="320"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8,0,8,16" LastChildFill="False">
            <TextBlock Text="Waddle" FontSize="34" FontWeight="ExtraBold"
                       Foreground="{StaticResource Ink}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Recalibrate face size"
                        Command="{Binding RecalibrateCommand}" Click="Recalibrate_Click"
                        Style="{StaticResource WaddleButton}" Margin="0,0,10,0"/>
                <Button Content="{Binding Source={x:Static local:TimeTracker.Instance}, Path=TimerButtonText}"
                        Command="{Binding StartTimerCommand}" Click="Start_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>

        <!-- Cumulative time sat up today, shared with the widget -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Sat up today" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{Binding Source={x:Static local:TimeTracker.Instance}, Path=TodayText}"
                           FontSize="60" FontWeight="ExtraBold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="{Binding Source={x:Static local:TimeTracker.Instance}, Path=StatusText}"
                           Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>

                <!-- Only while a session is running and the widget is closed -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                            Visibility="{Binding Source={x:Static local:TimeTracker.Instance}, Path=ShowDashboardControls, Converter={StaticResource BoolToVis}}">
                    <Button Padding="22,10" Margin="0,0,10,0" Style="{StaticResource WaddleButton}" Click="Pause_Click"
                            Content="{Binding Source={x:Static local:TimeTracker.Instance}, Path=PauseButtonText}"/>
                    <Button Content="Stop" Padding="22,10" Style="{StaticResource PrimaryButton}" Click="Stop_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="8,4,8,0"/>
    </Grid>
</Window>

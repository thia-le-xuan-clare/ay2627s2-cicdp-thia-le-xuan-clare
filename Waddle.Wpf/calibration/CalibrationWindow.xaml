<Window x:Class="Waddle.Wpf.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waddle - Calibrate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC3B2F14"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>

    <!-- The window itself is the frosted backdrop (sized to the screen in code-behind); the card sits in the middle. -->
    <Border Style="{StaticResource Card}"
            Width="540"
            Padding="22,16,22,22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Exit button pinned to top-left -->
            <Button Grid.Row="0"
                    Content="Exit"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource WaddleButton}"
                    Padding="14,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"/>

            <!-- Screen 1: live camera, countdown and Scan -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="{Binding IsLive, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and Subtitle aligned on the same top row as Exit -->
                <StackPanel Grid.Row="0"
                            Margin="65,0,65,12"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Get started!"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource Beak}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,2"
                               Visibility="{Binding IsFirstRun, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding StatusTitle}"
                               FontSize="22"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="{StaticResource Muted}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Camera Frame & Scan Button -->
                <StackPanel Grid.Row="1">
                    <Border Height="300"
                            CornerRadius="12"
                            Background="{StaticResource Ink}">
                        <Grid>
                            <!-- selfie view: the picture is mirrored so moving left looks like moving left -->
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Monitor.Frame}"
                                                Stretch="UniformToFill">
                                        <ImageBrush.RelativeTransform>
                                            <ScaleTransform ScaleX="-1"
                                                            CenterX="0.5"
                                                            CenterY="0.5"/>
                                        </ImageBrush.RelativeTransform>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <!-- "Starting camera..." or the camera problem, when there's no picture -->
                            <TextBlock Text="{Binding Monitor.OverlayText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource Surface}"
                                       FontSize="14"
                                       Margin="24"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Monitor.HasOverlay, Converter={StaticResource B2V}}"/>

                            <!-- big 3, 2, 1 -->
                            <TextBlock Text="{Binding Countdown}"
                                       FontSize="110"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Surface}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsCounting, Converter={StaticResource B2V}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="0"
                                                      Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Content="{Binding ScanText}"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="150"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Screen 2: already calibrated -->
            <StackPanel Grid.Row="1"
                        Visibility="{Binding IsAlreadyCalibrated, Converter={StaticResource B2V}}"
                        Margin="0,10,0,0">
                <TextBlock Text="You have already calibrated your face size."
                           Style="{StaticResource CardTitle}"
                           FontWeight="ExtraBold"
                           FontSize="22"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Would you like to calibrate again?"
                           Foreground="{StaticResource Ink}"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LastCalibratedText}"
                           Foreground="{StaticResource Muted}"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
                <Button Content="Rescan"
                        Command="{Binding RescanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="150"
                        HorizontalAlignment="Center"
                        Margin="0,22,0,6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
